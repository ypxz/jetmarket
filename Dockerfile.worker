# JetMarket worker — polls the jobs table for RFQ fan-out + quote notifications.
FROM node:20-alpine
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
ENV NODE_ENV=production
CMD ["pnpm", "--filter", "@jetmarket/worker", "start"]
