    "@jetmarket/providers": "workspace:*",
    "@jetmarket/ui": "workspace:*",
    "@jetmarket/verticals": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.0",
    "next-intl": "^4.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.5.25",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.42.0",
    "vitest": "^5.0.2"
