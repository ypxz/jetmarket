{
  "name": "jetmarket",
  "version": "0.1.0",
  "private": true,
  "description": "JetMarket \u2014 modular high-ticket marketplace, jets first (charter / empty legs / aircraft sale)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @jetmarket/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint && pnpm check:design",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm test:e2e",
    "db:up": "docker compose up -d postgres stripe-mock mailpit",
    "db:down": "docker compose down",
    "db:migrate": "pnpm -r --if-present migrate",
    "db:seed": "pnpm -r --if-present seed",
    "smoke": "tsx scripts/smoke.ts",
    "check:design": "tsx scripts/check-design-literals.ts"
  },
  "devDependencies": {
    "tsx": "4.20.5"
  },
  "type": "module"
}