{
  "name": "jetmarket",
  "version": "0.1.0",
  "private": true,
  "description": "JetMarket — modular high-ticket marketplace, jets first (charter / empty legs / aircraft sale)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @jetmarket/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint && node scripts/check-design-literals.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:contract": "pnpm -r --if-present test:contract",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "test:pending": "pnpm -r --if-present test:pending",
    "test:all": "node scripts/test-all.mjs",
    "db:up": "docker compose up -d postgres stripe-mock mailpit",
    "db:down": "docker compose down",
    "db:migrate": "pnpm -r --if-present migrate",
    "db:seed": "pnpm -r --if-present seed",
    "smoke": "pnpm -r --if-present smoke"
  }
}
