#!/usr/bin/env bash
# Runs before `git push`: the two fastest whole-repo gates. QA-322 showed a
# typecheck error can reach main when only per-suite tests run — CI is
# billing-blocked on this org, so this hook IS the gate.
# Skip when needed: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
pnpm typecheck
pnpm lint
