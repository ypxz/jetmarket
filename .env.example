# JetMarket environment contract — every variable documented, mock-safe defaults.
# Copy to .env.local for `pnpm dev`. Nothing here is a secret; real keys go in your
# local env / deploy platform only. NEVER commit real values.

# --- Product -----------------------------------------------------------------
# Which vertical config folder the app boots with (packages/verticals/<slug>).
VERTICAL=jets
# Public origin used in emails / absolute links.
APP_URL=http://localhost:3000

# --- Database ----------------------------------------------------------------
# Local Postgres from `pnpm db:up` (docker-compose.yml).
DATABASE_URL=postgres://jetmarket:jetmarket@localhost:5432/jetmarket

# --- Auth --------------------------------------------------------------------
# mock = email magic link written to tmp/outbox + signed session cookie.
# supabase = real implementation skeleton (needs SUPABASE_URL + SUPABASE_ANON_KEY
# + SUPABASE_SERVICE_ROLE_KEY). TODO(go-live).
AUTH_PROVIDER=mock
# Secret used to sign session cookies in mock mode — change in real deploys.
SESSION_SECRET=dev-only-not-a-secret

# --- Payments (subscriptions + success-fee invoices) --------------------------
# mock = instant success; stripe = SDK vs stripe-mock (STRIPE_API_BASE) or live.
PAYMENTS_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Point at stripe-mock from `pnpm db:up` for contract tests.
STRIPE_API_BASE=http://localhost:12111

# --- Email -------------------------------------------------------------------
# mock = writes .eml/.json to tmp/outbox; smtp = Mailpit from `pnpm db:up`;
# resend = real skeleton (needs RESEND_API_KEY). TODO(go-live).
EMAIL_PROVIDER=mock
EMAIL_FROM=JetMarket <noreply@jetmarket.local>
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=

# --- Storage (listing photos) -------------------------------------------------
# mock = local filesystem under ./storage; s3/supabase skeletons for go-live.
STORAGE_PROVIDER=mock
STORAGE_DIR=./storage

# --- Captcha / abuse ----------------------------------------------------------
# mock = always pass; turnstile skeleton (needs TURNSTILE_SECRET_KEY). TODO(go-live).
CAPTCHA_PROVIDER=mock
TURNSTILE_SECRET_KEY=
# RFQ rate limit per IP per hour.
RFQ_RATE_LIMIT_PER_HOUR=5

# --- Search -------------------------------------------------------------------
# postgres (default, full-text + jsonb facets). meilisearch = optional skeleton.
SEARCH_PROVIDER=postgres
MEILISEARCH_URL=
MEILISEARCH_KEY=

# --- Analytics ----------------------------------------------------------------
ANALYTICS_PROVIDER=mock

# --- LLM (unused tonight; adapter stub kept for parity with the template) ------
LLM_PROVIDER=mock
OPENAI_KEY=
